// Deploys this folder to https://sortd.page (Cloudflare Workers static assets).
// Update the site: cd site && npx wrangler deploy
{
  "name": "sortd",
  "compatibility_date": "2026-09-18",
  // The Worker runs first on every request: it sends www.sortd.page to https://sortd.page
  // (one address for Google), handles /api/beta, and serves everything else as plain files.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Emails each beta sign-up to the verified address in the BETA_TO secret.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Flood guard for POST /api/beta: 5 sign-ups per minute per IP, then 429.
  // Stops someone scripting the form to bomb the inbox. Counters live at the edge,
  // nothing is stored. namespace_id is just a unique number; bump it if you add another.
  "ratelimits": [{ "name": "BETA_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "routes": [
    { "pattern": "sortd.page", "custom_domain": true },
    { "pattern": "www.sortd.page", "custom_domain": true }
  ]
}
