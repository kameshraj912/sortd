/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cache-Control: no-transform

/img/*
  Cache-Control: public, max-age=604800

/apple-pay.shortcut
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Log Apple Pay in Sortd.shortcut"
  Cache-Control: public, max-age=3600

/apple-pay-26.shortcut
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Log Apple Pay in Sortd.shortcut"
  Cache-Control: public, max-age=3600

/setup-guide.pdf
  Cache-Control: public, max-age=3600
