// The PostHog relay: https://relay.sortd.page passes the app's usage events on to
// PostHog's US cloud. Blocking apps and DNS filters block posthog.com by name; an
// address on Sortd's own domain gets through. Nothing is stored here.
// Deploy: cd relay && npx wrangler deploy
{
  "name": "sortd-relay",
  "compatibility_date": "2026-10-06",
  "main": "src/index.js",
  "routes": [{ "pattern": "relay.sortd.page", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
