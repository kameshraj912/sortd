// Copy this file to Secrets.xcconfig (same folder, next to Config.xcconfig)
// and fill in the values. Secrets.xcconfig is gitignored and the pre-commit
// hook refuses it; Config.xcconfig picks it up with `#include?` when present,
// so a missing file never breaks the build (analytics just stays off).
//
// The PostHog project key ("phc_...") is write-only: it can send events but
// not read them. Never the personal "phx_" key.
POSTHOG_API_KEY = phc_replace_me
// "//" would start a comment here, hence the empty $() in the middle.
POSTHOG_HOST = https:/$()/eu.i.posthog.com
